{
  "scope": "nonprofit_registry",
  "agent": "AUERNYX",
  "context": "SQUAD",
  "version": "1.0.0",
  "purpose": "Allow listing/filtering of nonprofit veteran support resources while preventing ranking, recommendations, eligibility decisions, or outcome promises.",
  "registry_rules": {
    "registry_read_only": true,
    "allowed_output_fields": [
      "provider_id",
      "name",
      "org_type",
      "coverage_counties",
      "cities",
      "services",
      "va_visibility",
      "notes",
      "contact",
      "urls",
      "phones",
      "emails",
      "address",
      "alternate_locations",
      "source_hints"
    ],
    "allowed_filters": [
      "county",
      "city",
      "service_tag",
      "org_type",
      "va_visibility"
    ]
  },
  "service_taxonomy": {
    "mode": "controlled_vocab",
    "_comment": "allowed_service_tags stays a FLAT list — it's the strict validation vocabulary used by load_registry()/the JSON schema. tag_hierarchy below is a separate, additive annotation used only by the search/routing layer; it does not change what's a valid tag, only how a search expands a query. Both parents (broad, used by full-service providers like a VAMC that don't itemize) and children (specific, used by specialized providers like a Vet Center) are independently valid standalone tags on a record.",
    "allowed_service_tags": [
      "claims_assistance",
      "benefits_navigation",
      "housing_support",
      "homelessness_prevention",
      "emergency_financial_aid",
      "financial_counseling",
      "legal_referral",
      "immigration_legal",
      "legal_advocacy",
      "resource_referral",
      "transportation",
      "mental_health",
      "mental_health_peer_support",
      "clinical_therapy_referral",
      "mst_counseling",
      "bereavement",
      "substance_use",
      "primary_care",
      "lab",
      "pharmacy",
      "specialty_care",
      "inpatient",
      "prosthetics",
      "social_work",
      "equine_therapy",
      "outdoor_recreation",
      "adaptive_sports",
      "art_therapy",
      "education_support",
      "employment_support",
      "employment_transition",
      "skillbridge_coordination",
      "tap_program",
      "caregiver_support",
      "family_support",
      "social_connection",
      "advocacy",
      "dv_advocacy",
      "emergency_shelter",
      "dv_shelter",
      "memorial_civic"
    ],
    "tag_hierarchy": {
      "_comment": "child -> parent. Verified 2026-09-05 against every real provider record in DATA/ (56 shards, 50 states + CO/WA regional): every mismatched tag load_registry() rejected was cross-referenced against the actual providers using it (a VAMC tagging itself broadly with the parent vs. a specialized provider like a Vet Center itemizing the specific child) before being added here — none of these are guessed.",
      "mental_health_peer_support": "mental_health",
      "clinical_therapy_referral": "mental_health",
      "mst_counseling": "mental_health",
      "bereavement": "mental_health",
      "substance_use": "mental_health",
      "lab": "primary_care",
      "pharmacy": "primary_care",
      "inpatient": "specialty_care",
      "prosthetics": "specialty_care",
      "social_work": "specialty_care",
      "employment_transition": "employment_support",
      "skillbridge_coordination": "employment_support",
      "tap_program": "employment_support",
      "financial_counseling": "emergency_financial_aid",
      "emergency_shelter": "housing_support",
      "dv_shelter": "housing_support",
      "dv_advocacy": "advocacy",
      "legal_advocacy": "advocacy",
      "immigration_legal": "legal_referral",
      "transportation": "resource_referral"
    },
    "crisis_widened_branches": {
      "_comment": "When intake flags a health/welfare or self-harm concern, search() widens a query for any tag in one of these branches to match the whole branch (parent + every child), not just the exact tag requested — a crisis search must never come back narrower than a routine one. Scoped to the mental_health branch only, per the specific 'health and welfare or self harm' framing this was built for; not applied to the other branches above.",
      "mental_health": [
        "mental_health",
        "mental_health_peer_support",
        "clinical_therapy_referral",
        "mst_counseling",
        "bereavement",
        "substance_use"
      ]
    }
  },
  "prohibited": {
    "ranking_or_recommendation": {
      "blocked_fields": [
        "rank",
        "score",
        "rating",
        "stars",
        "recommended",
        "best",
        "top_pick",
        "priority",
        "preferred",
        "confidence"
      ],
      "blocked_phrases": [
        "best",
        "top",
        "recommended",
        "go with",
        "you should choose",
        "start with this one",
        "this is better than",
        "most effective",
        "fastest",
        "guaranteed"
      ]
    },
    "eligibility_or_outcome": {
      "blocked_phrases": [
        "you qualify",
        "eligible",
        "will be approved",
        "will get you",
        "increase your chances",
        "guarantee",
        "likely outcome",
        "you will receive"
      ]
    }
  },
  "required_behavior": {
    "no_preference": true,
    "no_outcome_promises": true,
    "no_eligibility_assessment": true,
    "default_disclaimer": "Availability and eligibility are determined by the organization directly. Contact them to confirm current services and intake."
  },
  "failure_mode": {
    "on_prohibited_request": [
      "refuse_comparison_or_prediction",
      "restate_scope",
      "offer_multiple_options_filtered_by_user_criteria"
    ]
  },
  "governance": {
    "mutable": false,
    "requires_clerk_override": true,
    "log_scope_violations": true
  }
}
